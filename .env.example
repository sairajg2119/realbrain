# Copy this file to .env.local and fill in the values. Never commit .env.local.
GEMINI_API_KEY=
# Optional: defaults to gemini-3.6-flash
GEMINI_MODEL=
BLOB_READ_WRITE_TOKEN=
# Phase 2 (video)
VIDEO_PROVIDER=heygen
HEYGEN_API_KEY=

# Contact form: Supabase row (RLS on) + Gmail emails. See supabase/contact_messages.sql
SUPABASE_URL=
SUPABASE_ANON_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: who gets the notification (defaults to GMAIL_USER)
CONTACT_OWNER_EMAIL=
